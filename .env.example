# Database (Docker container on host port 5433)
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_secret
POSTGRES_DB=stockflow_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://stockflow:stockflow_secret@localhost:5433/stockflow_db?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_ACCESS_SECRET="stockflow_access_jwt_secret_key_production_grade_32chars_min"
JWT_REFRESH_SECRET="stockflow_refresh_jwt_secret_key_production_grade_32chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Client
CLIENT_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
